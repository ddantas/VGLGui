WorkspaceBegin: 1.0

VariablesBegin:

VariablesEnd:

# Workspace principal: carrega imagem, aplica procedure, exibe resultado

Glyph:VGL_CL:vglLoad2dImage::localhost:1:100:150:: -filename 'data/images/fundus/1_good.JPG' -iscolor 1 -has_mipmap 0

# Nó da procedure no canvas principal
ProcedureBegin:GrayscaleConvert:ProcedureBegin::localhost:100:400:150::

# Glyphs internos da procedure GrayscaleConvert (ordem topológica)
ExtPort:out:External Input (1)::localhost:91:50:200::
Glyph:VGL_CL:vglCreateImage::localhost:10:200:200::
Glyph:VGL_CL:vglClRgb2Gray::localhost:11:400:200::
ExtPort:out:External Output (1)::localhost:92:600:200::

# Conexões internas da procedure
NodeConnection:data:91:i:10:img
NodeConnection:data:91:i:11:img_input
NodeConnection:data:10:RETVAL:11:img_output
NodeConnection:data:11:img_output:92:o

ProcedureEnd:GrayscaleConvert

Glyph:VGL_CL:ShowImage::localhost:2:700:150::

# Conexões do workspace principal
NodeConnection:data:1:RETVAL:100:i
NodeConnection:data:100:o:2:image

WorkspaceEnd: 1.0
